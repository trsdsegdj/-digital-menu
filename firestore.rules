rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /config/site {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
